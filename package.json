{
  "name": "wooram-b2b",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "setup": "node scripts/setup.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "inventory:expire": "tsx scripts/expire.ts",
    "db:local": "node scripts/local-db.mjs",
    "admin:create": "tsx scripts/create-admin.ts",
    "format": "prettier --write src prisma/seed.ts scripts tests *.ts *.mjs *.json *.yml *.yaml docs/*.md"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@prisma/client": "^6.19.0",
    "better-auth": "^1.4.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.2.0",
    "embedded-postgres": "17.4.0-beta.15",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "17.4.0-beta.15"
  }
